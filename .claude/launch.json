{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "visual-output",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "python",
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "tests/visual/output"
      ],
      "port": 8765
    },
    {
      "name": "docs",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--group",
        "docs",
        "zensical",
        "serve",
        "--dev-addr",
        "127.0.0.1:8000"
      ],
      "port": 8000
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "site"
      ],
      "port": 8766
    }
  ]
}
